{
  "manifest_version": 3,
  "name": "Google Maps Business Collector",
  "version": "1.0.0",
  "description": "Collect publicly displayed business information from Google Maps pages into your Laravel backend.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.google.co.in/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps*",
        "https://*.google.com/maps/*",
        "https://*.google.co.in/maps*",
        "https://*.google.co.in/maps/*",
        "https://*.google.com/*",
        "https://*.google.co.in/*"
      ],
      "js": [
        "utils/parser.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
